# A database host on your own machine
DB_HOST=127.0.0.1
# Test user who will connect to the database
DB_USER=ecommerce_test_user
# Test user password
DB_PASS=your_test_user_password
# Test database name. Must end in '_test'
DB_NAME=ecommerce_test
# Database engine port
DB_PORT=3306
# Database engine
DIALECT=mysql
# Environment. Must be 'test'
NODE_ENV=test
