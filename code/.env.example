# Port that uses local.js by default
PORT_APP=3000
# A database host on your own machine
DB_HOST=127.0.0.1
# User who will connect to the database
DB_USER=ecommerce_user
# User password
DB_PASS=change_this
# Database name
DB_NAME=ecommerce
# Database engine port
DB_PORT=3306
# Database engine
DIALECT=mysql
# Environment. Must be 'development' to mount POST /db/sync (otherwise it returns 404)
NODE_ENV=development
